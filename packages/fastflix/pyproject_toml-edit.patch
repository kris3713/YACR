Date: Tue, 10 Nov 2026 14:25:24 -0600
Subject: [PATCH] Refactor dependencies in pyproject.toml

Updated dependencies in pyproject.toml to remove version constraints.
---
 pyproject.toml | 12 ++++++------
 1 file changed, 6 insertions(+), 6 deletions(-)

diff --git a/pyproject.toml b/pyproject.toml
index 7624bb58..a14cd11f 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -9,17 +9,17 @@ requires-python = ">=3.13"
 dynamic = ["version"]
 dependencies = [
     "platformdirs~=4.7",
-    "chardet>=5.1.0,<5.2.0",
+    "chardet",
     "colorama>=0.4,<1.0",
     "coloredlogs>=15.0,<16.0",
     "iso639-lang>=2.6.0,<3.0",
-    "mistune>=2.0,<3.0",
+    "mistune",
     "packaging>=23.2",
-    "pathvalidate>=2.4,<3.0",
-    "psutil>=5.9,<6.0",
+    "pathvalidate",
+    "psutil",
     "pydantic>=2.0,<3.0",
-    "pyside6==6.10.1",
-    "python-box[all]>=7.4,<8.0",
+    "pyside6",
+    "python-box[all]",
     "requests>=2.28,<3.0",
     "setuptools>=75.8",
     "wmi>=1.5.1; sys_platform == 'win32'",
