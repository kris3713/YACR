#!/usr/bin/env fish

set -l script_dir (status dirname)
set -l basename (basename "$script_dir")

source "$script_dir/../constants.fish"

echo "Updating '$basename'"

set -l url 'https://api.github.com/repos/musicbrainz/picard/releases/latest'
set -l regex "release-$VERSION_REGEX"
set -l jsonpath '$.tag_name'

echo 'Executing the `parse-json` script for $latest_version'
set -l latest_version ("$script_dir/../../scripts/parse-json" $url $regex $jsonpath)

set -l version_url "https://api.github.com/repos/musicbrainz/picard/commits/release-$latest_version"
set -l commit_jsonpath '$.sha'

echo 'Executing the `parse-json` script for $latest_commit'
set -l latest_commit ("$script_dir/../../scripts/parse-json" $version_url '' $commit_jsonpath)


if test -z "$latest_version"
  echo "Failed to get the latest version for '$basename'"
  echo 'Exitting...'
  exit 1
else if test -z "$latest_commit"
  echo "Failed to get the latest commit for '$basename'"
  echo 'Exitting...'
  exit 1
end

set -l current_version (cat "$script_dir/$basename.spec" | rg -or '$1' "Version:\\s*$VERSION_REGEX")
set -l current_commit (cat "$script_dir/$basename.spec" | rg -or '$1' 'commit\\s([\\w]{40}.*)')

echo 'Comparing the current version ($current_version) with the latest version ($latest_version)
AND Comparing the current commit ($current_commit) with the latest commit ($latest_commit)'
echo "Current version: $current_version AND Current commit: $current_commit"
echo "Latest version: $latest_version AND Latest commit: $latest_commit"
if test "$current_version" != "$latest_version" -a "$current_commit" != "$latest_commit"
  echo 'Versions are different. Updating the spec file(s)...'
  for v in (fd --glob '*.spec' $script_dir)
    sd "(Version\\:\\s*)$current_version" "\${1}$latest_version" $v
    sd -F "commit $current_commit" "commit $latest_commit" $v
  end && echo 'Done!'
else
  echo 'Both versions and commits are the same. No update needed.'
end

echo "Finished updating '$basename'"
