#!/usr/bin/env bash

# This script builds rpm packages safely
# by executing all the required commands
# in an ultramarine-linux container.
#
# USAGE:
#
# ./scripts/build-in-container <name-of-rpm-spec-file>
#
# OR
#
# ./scripts/build-in-container <name-of-directory-of-rpm-spec-file> <name-of-rpm-spec-file>

set -x -euo pipefail

# Cleanup function to catch exits, errors, and Ctrl+C (SIGINT)
cleanup() {
  local exit_code=$?
  if [ -n "${RANDOM_NAME:-}" ]; then
    podman kill "$RANDOM_NAME" --signal=KILL 2>/dev/null || true
    podman rm -fv "$RANDOM_NAME" 2>/dev/null || true
  fi
  exit "$exit_code"
}

trap cleanup EXIT INT TERM

# Checks if the required commands
# are availible or not
check_commands() {
  local COMMANDS=('uvx' 'podman' 'fd')
  local missing=()

  for cmd in "${COMMANDS[@]}"; do
    if ! command -v "$cmd" >/dev/null; then
      missing+=("$cmd")
    fi
  done

  if [ ${#missing[@]} -gt 0 ]; then
    # shellcheck disable=SC2016
    echo "Please ensure ${missing[*]} are installed!
    The script will otherwise not work."
    exit 1
  fi
}

check_commands

# Check if number of arguments are more than
# 2 or none
if [ "$#" -gt 2 ] || [ "$#" -eq 0 ]; then
  echo "Usage: $0 <arg1> <arg2>"
  exit 1
fi

SCRIPT_DIR=$(dirname "$(readlink -f "$0")")
PROJECT_DIR="$(realpath "$SCRIPT_DIR/..")"

# Set the initial build directory
build_dir="$PROJECT_DIR/build"

if [ ! -d "$build_dir" ]; then
  mkdir -v "$build_dir"
fi

RANDOM_NAME="$(uvx petname 2>/dev/null)"

# Create the container
podman run -d \
  --init \
  --replace \
  --pull=always \
  "--name=$RANDOM_NAME" \
  -v "$PROJECT_DIR:/project" \
  -v "$build_dir:/project/build" \
  --network host \
  ghcr.io/ultramarine-linux/ultramarine:44 \
  sleep infinity
# TODO: Update the image tag if availible ^

# For ease of use
PODMAN_EXEC_CMD="podman exec -it $RANDOM_NAME"

# Turn off weak deps and enable best candidate
$PODMAN_EXEC_CMD sudo dnf config-manager \
  setopt install_weak_deps=False
$PODMAN_EXEC_CMD sudo dnf config-manager \
  setopt best=True

# Enable required COPR repos, install important pkgs
$PODMAN_EXEC_CMD sudo dnf copr enable -y zliced13/YACR
$PODMAN_EXEC_CMD sudo dnf copr enable -y scottames/mise
$PODMAN_EXEC_CMD sudo dnf install -y git rpmdevtools

# Change the build directory again
build_dir='/project/build'

# Builds the package based on the arguments provided
build_package() {
  mkdir -pv "$PROJECT_DIR/build/SOURCES"

  # shellcheck disable=2155
  local SOURCE_FILES=$(fd \
    -E '*.spec' \
    -I \
    -E update-script \
    '.' \
    "$PROJECT_DIR/packages/$1")
  for source_file in $SOURCE_FILES; do
    [ -f "$source_file" ] \
      && cp -v "$source_file" "$PROJECT_DIR/build/SOURCES"
  done

  local SPEC_PATH="/project/packages/$1/$2.spec"
  $PODMAN_EXEC_CMD sudo dnf builddep -y "$SPEC_PATH"
  $PODMAN_EXEC_CMD spectool \
    --define "_topdir $build_dir" \
    --sourcedir -g "$SPEC_PATH"
  $PODMAN_EXEC_CMD rpmbuild \
    --define "_topdir $build_dir" \
    -bb "$SPEC_PATH"
}

if [ "$#" -eq 1 ]; then
  build_package "$1" "$1"
elif [ "$#" -eq 2 ]; then
  build_package "$1" "$2"
fi
